server {
    listen       8080;
    listen  [::]:8080;
    server_name  _;  # Catch-all virtual host; this config is not tied to a specific hostname.

    root   /usr/share/nginx/html;
    index  index.html;

    location = /api/terminal/stream {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};  # No trailing slash: pass the original /api/terminal/stream path upstream unchanged.
        proxy_http_version 1.1;  # Preserve HTTP/1.1 here because websocket upgrade relies on it.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};  # No trailing slash: /api/labs stays /api/labs when forwarded to the backend.
        proxy_http_version 1.1;  # Kept for consistent upstream behavior, though the current REST endpoints do not require it.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}