{
  "name": "frontend",
  "version": "0.0.0",
  "engines": {
    "node": "26.10.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "check:runtime": "node -e \"const expected=require('./package.json').engines.node; const actual=process.versions.node; if (actual !== expected) { console.error('Expected Node.js ' + expected + ' but found ' + actual); process.exit(1); }\"",
    "preinstall": "npm run check:runtime",
    "ng": "ng",
    "start": "npm run check:runtime && ng serve",
    "build": "npm run check:runtime && ng build",
    "watch": "npm run check:runtime && ng build --watch --configuration development",
    "test": "npm run check:runtime && ng test"
  },
  "private": true,
  "packageManager": "npm@12.2.1",
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "vitest": "^5.0.5"
  }
}
